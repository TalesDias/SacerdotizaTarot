---
import { Image } from 'astro:assets';
import type { Reading } from '../data/content';
import { bookingLink } from '../data/site';

interface Props {
  reading: Reading;
  /** Decorative card back that peeks out on hover. Absent until the art is added. */
  peek?: ImageMetadata;
}
const { reading, peek } = Astro.props;
---

<article class="card" tabindex="0">
  {peek && <Image src={peek} alt="" class="peek" widths={[62, 124, 186]} sizes="62px" loading="lazy" aria-hidden="true" />}

  <div class="head">
    <h4>{reading.title}</h4>
    <span class="tag">{reading.tag}</span>
  </div>

  <div class="body">
    <div class="body-inner">
      <p class="text">{reading.text}</p>
      <div class="foot">
        <span class="price">{reading.priceLabel}</span>
        <a class="book" href={bookingLink(reading.title)} target="_blank" rel="noopener">Agendar</a>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    padding: 24px 22px;
    border-radius: 16px;
    background: var(--surface);
    border: 2px solid rgba(123, 106, 94, 0.1);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease),
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.35s;
    -webkit-tap-highlight-color: transparent;
  }

  .head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    /* The tag is nowrap and cannot shrink, and the title cannot go below its
       longest word — without wrapping, the pill escapes the card on narrow
       columns (e.g. "Decifrando o Parceiro" in a 4-up grid at 1400px). */
    flex-wrap: wrap;
    /* Wrapping costs 37px, so a long title made its card taller than its
       siblings. Reserve the wrapped height for every card — title line (23px
       x 1.2) + gap + tag (23px + 4px offset) — so the tag still sits inline
       where it fits, but the group stays level either way. */
    min-height: 65px;
  }

  h4 {
    margin: 0;
    font-size: 23px;
    line-height: 1.2;
    color: var(--ink);
  }

  .tag {
    flex: none;
    margin-top: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 20%, #fff);
    border: 1px solid var(--accent);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .peek {
    position: absolute;
    top: 0;
    right: 14px;
    width: 62px;
    height: auto;
    border-radius: 4px;
    display: block;
    border: 2px solid #fff;
    box-shadow: 0 10px 22px rgba(90, 45, 55, 0.28);
    opacity: 0;
    transform: translateY(6px) rotate(0deg);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.25, 1),
      opacity 0.35s ease;
    pointer-events: none;
    z-index: 3;
  }

  .body {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
    transition:
      grid-template-rows 0.38s var(--ease),
      opacity 0.3s;
  }

  .body-inner {
    min-height: 0;
  }

  .text {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--body);
    text-wrap: pretty;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(123, 106, 94, 0.16);
  }

  .price {
    font-size: 19px;
    font-weight: 700;
    color: var(--clay);
  }

  .book {
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--clay);
    color: var(--base);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.25s;
  }

  .book:hover {
    background: var(--ink);
    color: var(--base);
  }

  /*
   * Collapsed everywhere, not just on pointer devices. Hover opens it on
   * desktop; :focus-within covers both keyboard (the Agendar link inside is
   * focusable) and touch, where a tap focuses the card itself via tabindex.
   */
  .body {
    grid-template-rows: minmax(0, 0fr);
    opacity: 0;
  }

  .card:hover,
  .card:focus-within {
    background: color-mix(in oklab, var(--accent) 20%, #fff);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-5px);
    /* The canvas opened on a 220 ms timer; as a delay it applies on the way
       in only, so leaving still closes immediately. */
    transition-delay: 220ms;
  }

  .card:hover .body,
  .card:focus-within .body {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    transition-delay: 220ms;
  }

  .card:hover .tag,
  .card:focus-within .tag {
    opacity: 0;
    transition-delay: 220ms;
  }

  .card:hover .peek,
  .card:focus-within .peek {
    opacity: 1;
    transform: translateY(-46px) rotate(5deg);
    transition-delay: 220ms;
  }

  /* Where there is no hover the card is tapped, so it should look tappable.
     iOS also needs a pointer cursor before it treats a non-form element as
     tappable, which is what makes the tap focus it. */
  @media (hover: none) {
    .card {
      cursor: pointer;
    }
  }

  /* The whole card is the hit target, so it gets the focus ring, not a subrect. */
  .card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

</style>
