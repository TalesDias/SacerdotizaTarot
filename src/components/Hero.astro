---
import { Picture } from 'astro:assets';
import portrait from '../assets/yara.webp';
import priestess from '../assets/yara-priestess.webp';
import { BIO } from '../data/content';
import { SITE_NAME, TAGLINE, TAROLOGA, INSTAGRAM_URL, waLink } from '../data/site';
---

<header class="hero">
  <div class="titles">
    <h1>{SITE_NAME}</h1>
    <p class="tagline">{TAGLINE}</p>
  </div>

  <div class="intro">
    <div class="portrait-frame">
      <div class="portrait-ring" data-portrait>
        <div class="slot">
          <Picture
            src={portrait}
            alt={`${TAROLOGA}, taróloga e mestre de baralho cigano`}
            widths={[260, 520, 780]}
            sizes="min(260px, 58vw)"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        </div>
        <div class="slot">
          <Picture
            src={priestess}
            alt=""
            widths={[260, 520, 780]}
            sizes="min(260px, 58vw)"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            class="portrait"
          />
        </div>
      </div>
    </div>
    <p class="bio">{BIO}</p>
  </div>

  <div class="actions">
    <a class="btn btn-solid" href={waLink()} target="_blank" rel="noopener">
      <span class="pip" style="background:var(--accent-2)"></span>WhatsApp
    </a>
    <a class="btn btn-ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">
      <span class="pip" style="background:var(--accent-1)"></span>Instagram
    </a>
  </div>

  <a class="scroll-cue" href="#jogos">
    <span>Conheça os Jogos</span>
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</header>

<script>
  const coin = document.querySelector<HTMLElement>('[data-portrait]');

  if (coin && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let turns = 0;
    const step = () => {
      // Accumulating keeps it spinning the same way instead of rocking back.
      coin.style.transform = `rotateY(${++turns * 180}deg)`;
      // The first two turns come quickly, then it settles into a slow rotation.
      setTimeout(step, turns < 2 ? 2000 : 10000);
    };
    setTimeout(step, 2000);
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 0 24px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .titles {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font-size: clamp(46px, 8.6vw, 118px);
    line-height: 0.98;
    text-align: center;
    letter-spacing: -0.01em;
    color: var(--clay);
    text-wrap: balance;
  }

  .tagline {
    margin: 0;
    font-size: clamp(12px, 1.6vw, 14px);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-align: center;
    color: var(--clay);
  }

  .intro {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 4vw, 48px);
    max-width: 900px;
  }

  /* Perspective lives on the parent so the coin has depth as it turns. */
  .portrait-frame {
    flex: 0 0 auto;
    perspective: 1200px;
  }

  /* The whole disc is the coin — white rim included — so it reads as one
     object edge-on at 90deg rather than a picture spinning inside a ring. */
  .portrait-ring {
    position: relative;
    width: calc(min(260px, 58vw) + 24px);
    height: calc(min(260px, 58vw) + 24px);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 14px 40px rgba(123, 106, 94, 0.14);
    transform-style: preserve-3d;
    transition: transform 0.95s cubic-bezier(0.45, 0.05, 0.35, 1);
  }

  /* Two faces of the same disc. The back one is pre-turned, so every 180deg
     of the parent swaps which one points at the viewer — no class toggling. */
  .slot {
    position: absolute;
    inset: 12px;
    backface-visibility: hidden;
  }

  .slot:nth-child(2) {
    transform: rotateY(180deg);
  }

  .portrait {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }

  .bio {
    flex: 1 1 320px;
    min-width: 280px;
    max-width: 530px;
    margin: 0;
    text-align: justify;
    font-size: 17px;
    line-height: 1.75;
    color: var(--body);
    text-wrap: pretty;
  }

  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  .actions .btn {
    padding: 13px 26px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .scroll-cue {
    position: relative;
    margin-top: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 0 28px;
    /* Canvas used #b08d86 — 2.80:1 on the cream ground, below the AA floor. */
    color: var(--clay);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .scroll-cue:hover {
    color: var(--ink);
  }

  /* Justified text on a ~340px column opens rivers of whitespace; the canvas
     only ever rendered this at desktop width. */
  @media (max-width: 559px) {
    .bio {
      text-align: left;
    }
  }

  .arrow {
    font-size: 16px;
    letter-spacing: normal;
    animation: sdrift 2.4s ease-in-out infinite;
  }
</style>
