---
import { Picture } from 'astro:assets';
import portrait from '../assets/yara.webp';
import priestess from '../assets/yara-priestess.webp';
import cacau from '../assets/cats/cacau.png';
import { BIO } from '../data/content';
import { SITE_NAME, TAGLINE, TAROLOGA, INSTAGRAM_URL, waLink } from '../data/site';
---

<header class="hero">
  <div class="titles">
    <h1>{SITE_NAME}</h1>
    <p class="tagline">{TAGLINE}</p>
  </div>

  <div class="intro">
    <div class="portrait-ring">
      <div class="portrait-coin" data-portrait>
        <div class="slot">
          <Picture
            src={portrait}
            alt={`${TAROLOGA}, taróloga e mestre de baralho cigano`}
            widths={[260, 520, 780]}
            sizes="min(284px, 55vw)"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        </div>
        <div class="slot">
          <Picture
            src={priestess}
            alt=""
            widths={[260, 520, 780]}
            sizes="min(284px, 55vw)"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            class="portrait"
          />
        </div>
      </div>
      <Picture
        src={cacau}
        alt=""
        widths={[350, 700]}
        sizes="min(350px, 78vw)"
        formats={['avif']}
        fallbackFormat="webp"
        loading="eager"
        class="cacau"
      />
    </div>
    <p class="bio">{BIO}</p>
  </div>

  <div class="actions">
    <a class="btn btn-solid" href={waLink()} target="_blank" rel="noopener">
      <span class="pip" style="background:var(--accent-2)"></span>WhatsApp
    </a>
    <a class="btn btn-ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">
      <span class="pip" style="background:var(--accent-1)"></span>Instagram
    </a>
  </div>

  <a class="scroll-cue" href="#jogos">
    <span>Conheça os Jogos</span>
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</header>

<script>
  const coin = document.querySelector<HTMLElement>('[data-portrait]');

  if (coin && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let turns = 0;
    const step = () => {
      // Accumulating keeps it spinning the same way instead of rocking back.
      coin.style.transform = `rotateY(${++turns * 180}deg)`;
      // The first two turns come quickly, then it settles into a slow rotation.
      setTimeout(step, turns < 2 ? 2000 : 10000);
    };
    setTimeout(step, 2000);
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 0 24px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .titles {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font-size: clamp(46px, 8.6vw, 118px);
    line-height: 0.98;
    text-align: center;
    letter-spacing: -0.01em;
    color: var(--clay);
    text-wrap: balance;
  }

  .tagline {
    margin: 0;
    font-size: clamp(12px, 1.6vw, 14px);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-align: center;
    color: var(--clay);
  }

  .intro {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 4vw, 48px);
    max-width: 900px;
  }

  /*
   * The ring is the setting, not the coin: it carries the white disc and the
   * drop shadow and must never transform, or both foreshorten to an edge along
   * with the portrait. It only supplies the perspective its child turns in.
   */
  .portrait-ring {
    /*
     * The whole circle — photo plus its 3px rim. 284px is what it was when the
     * rim was 24px wide, so desktop is unchanged; the vw term is the only knob
     * a phone sees, and lowering it is how Cacau gets room to sit.
     */
    --disc: min(284px, 55vw);

    position: relative;
    flex: 0 0 auto;
    width: var(--disc);
    height: var(--disc);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 14px 40px rgba(123, 106, 94, 0.14);
    perspective: 1000px;
  }

  /*
   * Room for Cacau's ears, which sit above the circle and would otherwise
   * land on the tagline.
   *
   * A flat 20px is only enough while the circle is small. --disc reaches its
   * 284px ceiling at 516px wide, but the hero stays a single centred column
   * until about 680px — so through that whole band she is at full size and
   * still directly under the tagline. Measured overlap there is 4px; the
   * clamp gives 12px more room at the top of the range and leaves the
   * narrow-phone composition where it was.
   */
  @media (max-width: 819px) {
    .portrait-ring {
      margin-top: clamp(20px, 6.2vw, 32px);
    }
  }

  /* Fills the ring: the white rim is now the 3px the slots leave, not a band
     of disc showing around them. The ring keeps its size, so nothing in the
     hero shifts — the portrait just grows into the space the rim gave up. */
  .portrait-coin {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 0.95s cubic-bezier(0.45, 0.05, 0.35, 1);
  }

  /*
   * Draped over the top of the coin and, deliberately, outside it: a child of
   * the ring, so the flip turns the portrait underneath her while she stays
   * put. Purely decorative, hence the empty alt and no pointer target.
   *
   * Three numbers place her, and only these three:
   *
   *   --cat-size   her width, as a % of the portrait ring. Over 100% on
   *                purpose — she hangs off both sides of the circle.
   *   --cat-ride   how high she sits. Higher % lifts her off the photo;
   *                lower % sinks her further down over it. At 100% her tail
   *                tip would just touch the top of the circle.
   *   --cat-nudge  sideways. -50% is centred; toward -60% moves her left,
   *                toward -40% moves her right.
   *
   * The phone values are in the media query below — change both.
   */
  .cacau {
    --cat-size: 101%;
    --cat-ride: 55%;
    --cat-nudge: -64%;

    position: absolute;
    left: 50%;
    bottom: var(--cat-ride);
    z-index: 2;
    width: var(--cat-size);
    /* Opts out of the global img { max-width: 100% }, which would clamp her
       back to the ring's width the moment --cat-size goes over 100%. */
    max-width: none;
    height: auto;
    transform: translateX(var(--cat-nudge));
    pointer-events: none;
  }

  /* On a phone the tagline sits directly above a centred portrait, and at the
     desktop proportions her ears reach into it. Smaller, and lower. */
  @media (max-width: 759px) {
    .cacau {
      --cat-size: 100%;
      --cat-ride: 56%;
    }
  }


  /* Two faces of the same disc. The back one is pre-turned, so every 180deg
     of the parent swaps which one points at the viewer — no class toggling. */
  .slot {
    position: absolute;
    inset: 3px;
    backface-visibility: hidden;
  }

  .slot:nth-child(2) {
    transform: rotateY(180deg);
  }

  .portrait {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }

  .bio {
    flex: 1 1 320px;
    min-width: 280px;
    max-width: 530px;
    margin: 0;
    text-align: justify;
    /* Justifying a ~340px column opens rivers of whitespace. Hyphenation is
       what closes them: <html lang="pt-BR"> gives the browser the Portuguese
       patterns, so it can break inside words instead of stretching the spaces. */
    hyphens: auto;
    font-size: 17px;
    line-height: 1.75;
    color: var(--body);
    text-wrap: pretty;
  }

  .actions {
    position: relative;
    display: flex;
    /* Two short buttons: side by side at every width, rather than stacking into
       a column on a narrow phone. */
    flex-wrap: nowrap;
    gap: 14px;
    justify-content: center;
  }

  .actions .btn {
    padding: 13px 26px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
  }

  /* Narrow enough that the pair would otherwise overflow the row. */
  @media (max-width: 400px) {
    .actions {
      gap: 10px;
    }

    .actions .btn {
      padding: 13px 18px;
    }
  }

  .pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .scroll-cue {
    position: relative;
    margin-top: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 0 28px;
    /* Canvas used #b08d86 — 2.80:1 on the cream ground, below the AA floor. */
    color: var(--clay);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .scroll-cue:hover {
    color: var(--ink);
  }

  .arrow {
    font-size: 16px;
    letter-spacing: normal;
    animation: sdrift 2.4s ease-in-out infinite;
  }
</style>
