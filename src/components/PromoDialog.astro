---
import { PROMOS } from '../data/content';
import { INSTAGRAM_URL, waLink } from '../data/site';
import HeartIcon from './icons/HeartIcon.astro';
import SparkleIcon from './icons/SparkleIcon.astro';
import ToastIcon from './icons/ToastIcon.astro';

const ICONS: Record<string, typeof SparkleIcon> = {
  namorados: HeartIcon,
  caixinha: SparkleIcon,
  'ano-novo': ToastIcon,
};

// The year-end promo names the year its season looks ahead to. This is only the
// value at build time — the script rewrites it from the visitor's clock, which
// is what keeps a site built in one year correct in the next.
const year = new Date().getFullYear() + 1;
---

{
  PROMOS.map((promo) => {
    const Icon = ICONS[promo.id] ?? SparkleIcon;
    return (
      <dialog data-promo={promo.id} aria-labelledby={`promo-${promo.id}`}>
        <div class="head">
          <p id={`promo-${promo.id}`} class="title">
            {promo.title}
          </p>
          <Icon />
        </div>

        <p class="pitch" set:html={promo.text.replace('{ano}', `<b data-year>${year}</b>`)} />

        <div class="actions">
          <button type="button" class="btn btn-ghost" data-close>
            Fechar
          </button>
          <a
            class="btn btn-solid"
            href={promo.instagram ? INSTAGRAM_URL : waLink(promo.message)}
            target="_blank"
            rel="noopener"
            data-close
          >
            {promo.cta}
          </a>
        </div>
      </dialog>
    );
  })
}

<script>
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('[data-promo]')];

  if (dialogs.length) {
    // ?promo=<id> forces one open, ?now=<ISO date> moves the clock. Both are
    // there so the schedule can be checked in a browser without touching the
    // machine's clock; neither shows a visitor anything they could not see by
    // waiting for the date.
    const params = new URLSearchParams(location.search);
    const preview = params.get('promo');

    // Brazil's clock, not the visitor's: the offers run on São Paulo time, so
    // someone reading from elsewhere should see them while they are live.
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'America/Sao_Paulo',
      weekday: 'short',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date(params.get('now') ?? Date.now()));

    const at = (type: Intl.DateTimeFormatPartTypes) =>
      parts.find((part) => part.type === type)?.value ?? '';
    const weekday = at('weekday');
    const year = +at('year');
    const month = +at('month');
    const day = +at('day');
    const hour = +at('hour');

    // Each window returns an id for the occasion it is inside, or '' when shut.
    // Dismissals are stored against that id, so closing a promo silences this
    // Friday, or this June — not every one after it.
    const windows: Record<string, () => string> = {
      // Friday 09:00 to Saturday 09:00, weekly.
      caixinha: () => {
        const morningAfter = weekday === 'Sat' && hour < 9;
        if (!morningAfter && !(weekday === 'Fri' && hour >= 9)) return '';
        // Saturday morning still belongs to Friday's window, so both halves
        // answer with the same date and one dismissal covers all 24 hours.
        return new Date(Date.UTC(year, month - 1, day - (morningAfter ? 1 : 0)))
          .toISOString()
          .slice(0, 10);
      },

      // 6 to 12 June, the 12th included: Dia dos Namorados is the 12th, so a
      // promotion for it that stopped the day before would miss the point.
      namorados: () => (month === 6 && day >= 6 && day <= 12 ? String(year) : ''),

      // 1 December to 31 January. Named for the year it looks ahead to, which
      // is the year the copy needs as well.
      'ano-novo': () => (month === 12 ? String(year + 1) : month === 1 ? String(year) : ''),
    };

    let dialog: HTMLDialogElement | null = null;
    let occasion = '';

    // Document order is priority order — PROMOS lists them highest first.
    for (const el of dialogs) {
      const open = windows[el.dataset.promo ?? '']?.() ?? '';
      if (open) {
        dialog = el;
        occasion = open;
        break;
      }
    }

    if (preview) {
      dialog = dialogs.find((el) => el.dataset.promo === preview) ?? null;
      // The loop above stops at whichever promo is genuinely live, and the
      // occasion it found belongs to that one. Recompute it for the promo
      // being previewed — otherwise previewing the year-end promo in June
      // labels it with the Friday window's date. Empty is the honest answer
      // when the previewed promo's own window is shut; the year tag below
      // falls back to next year, which is what its copy means anyway.
      occasion = dialog ? (windows[preview]?.() ?? '') : '';
    }

    if (dialog) {
      const key = `sac-promo-${dialog.dataset.promo}`;
      const yearTag = dialog.querySelector('[data-year]');
      if (yearTag) yearTag.textContent = occasion || String(year + 1);

      const dismiss = () => {
        try {
          // A preview is not a real sighting, so it must not silence the promo
          // for whoever is testing it.
          if (!preview) localStorage.setItem(key, occasion);
        } catch {
          /* private mode — just close */
        }
        dialog.close();
      };

      dialog.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', dismiss));
      dialog.addEventListener('close', dismiss);

      let seen = false;
      try {
        seen = localStorage.getItem(key) === occasion;
      } catch {
        /* treat as unseen */
      }

      // A modal covers the page and makes it inert, which on a phone is the
      // interstitial pattern Google penalises — and a crawler arrives with an
      // empty localStorage every time, so it would meet one on every visit.
      // Below 768px the same dialog opens non-modally instead and the styles
      // turn it into a sheet on the bottom edge: no backdrop, and the page
      // behind stays readable, scrollable and clickable. That is the whole
      // difference between an interstitial and a banner.
      const roomy = window.matchMedia('(min-width: 768px)').matches;

      if (preview || !seen) {
        setTimeout(() => (roomy ? dialog.showModal() : dialog.show()), 900);
      }
    }
  }
</script>

<style>
  dialog {
    width: min(440px, 100%);
    padding: 38px 34px 32px;
    border: 2px solid var(--accent-3);
    border-radius: 22px;
    background: var(--base);
    box-shadow: 0 26px 70px rgba(74, 63, 56, 0.28);
    color: var(--ink);
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    animation: spromo 0.38s var(--ease) both;
  }

  dialog::backdrop {
    background: rgba(74, 63, 56, 0.34);
    backdrop-filter: blur(3px);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    /* "Tiragem de Fim de Ano" is more than twice the length of "Promoção",
       which the 40px of the canvas was sized for. */
    font-size: clamp(28px, 7vw, 40px);
    line-height: 1.1;
    /* Centred to match the pitch below — only visible now that a title can run
       to two lines. */
    text-align: center;
    text-wrap: balance;
    color: var(--clay);
  }

  .pitch {
    margin: 0;
    max-width: 360px;
    text-align: center;
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
    text-wrap: pretty;
  }

  .pitch b {
    font-weight: 700;
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  .actions .btn {
    padding: 13px 26px;
    font-size: 13px;
    letter-spacing: 0.08em;
    cursor: pointer;
    font-family: inherit;
    justify-content: center;
  }

  /*
   * The phone gets a sheet on the bottom edge instead of a card in the middle.
   * It is the same dialog and the same markup — opened with show() rather than
   * showModal(), so there is no backdrop and nothing behind it goes inert.
   *
   * Everything here is in service of keeping it short: a sheet earns its place
   * by leaving most of the page visible. Measured worst case (the longest
   * title, over the longest pitch, with both buttons stacked) is ~310px, a
   * little over a third of a phone screen.
   */
  @media (max-width: 767px) {
    dialog {
      position: fixed;
      inset: auto 0 0;
      /* Under the skip link at 100, over everything else on the page. */
      z-index: 90;
      width: 100%;
      /* Only a backstop, for a small screen at a large text size. */
      max-height: 75vh;
      overflow-y: auto;
      margin: 0;
      /* The sheet sits on the bottom edge, so the sides and bottom of the
         border would be drawn off-screen. Only the top one is left. */
      border-width: 2px 0 0;
      border-radius: 20px 20px 0 0;
      /* env() is 0 everywhere but an iPhone, where it clears the home bar. */
      padding: 18px 20px calc(18px + env(safe-area-inset-bottom));
      box-shadow: 0 -14px 40px rgba(74, 63, 56, 0.22);
    }

    dialog[open] {
      gap: 12px;
      animation-name: ssheet;
    }

    .title {
      font-size: 24px;
    }

    .pitch {
      font-size: 15.5px;
    }

    /* Stacked, and reversed so booking sits above Fechar — the action someone
       came for should be the one under their thumb, not the one below it.
       Document order is left alone, so Fechar stays the first tab stop. */
    .actions {
      flex-direction: column-reverse;
      align-self: stretch;
      gap: 10px;
    }
  }

  /*
   * A short screen is where the sheet stops being modest: the same ~260px is a
   * third of a tall phone but half of a 568px one. Gated on height, because
   * that is the thing actually running out — a wide-but-short screen has the
   * same problem. The row of buttons is most of the saving; on a sheet already
   * at the bottom edge both are within reach either way, so stacking them buys
   * nothing here that it buys on a centred card.
   */
  @media (max-width: 767px) and (max-height: 700px) {
    dialog {
      padding: 13px 16px calc(13px + env(safe-area-inset-bottom));
    }

    dialog[open] {
      gap: 9px;
    }

    .title {
      font-size: 21px;
    }

    .pitch {
      font-size: 14.5px;
      line-height: 1.5;
    }

    .actions {
      flex-direction: row;
      gap: 8px;
      margin-top: 0;
    }

    .actions .btn {
      /* Sized to its label, not halved: "Ir para o Instagram" is three times
         the length of "Fechar" and would wrap if both took equal widths. */
      flex: 0 1 auto;
      padding: 12px 14px;
      font-size: 11.5px;
      letter-spacing: 0.03em;
    }
  }
</style>
