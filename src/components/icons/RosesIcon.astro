---
/**
 * Rose garland swagging across the top of a package card, left corner to right.
 *
 * The vine is a quadratic curve anchored at both top corners — y = 5 + 102t(1−t)
 * over x = 300t — so every bloom and leaf sits on it by construction: the outer
 * roses at t=0.2/0.8 (x=60, x=240), the largest at the low point x=150, leaves
 * at t=0.35/0.65.
 *
 * The viewBox is trimmed to the ink (lowest point is the left leaf at y≈50), so
 * its box height is meaningful for laying out beneath it. At width:100% the
 * garland's height tracks the card and the blooms never distort.
 */
---
<svg viewBox="0 0 300 54" class="roses" aria-hidden="true">
  <path d="M0 5 Q150 56 300 5" fill="none" stroke="#2f2a27" stroke-width="4" stroke-linecap="round" />

  <g stroke="#8a6a35" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M105 28 l-3 7" fill="none" />
    <path d="M0 0 C12 -6 20 0 18 10 C10 14 1 10 0 0 Z" fill="#c9a24a"
          transform="translate(102 34) rotate(118) scale(.85)" />
    <path d="M195 28 l3 7" fill="none" />
    <path d="M0 0 C12 -6 20 0 18 10 C10 14 1 10 0 0 Z" fill="#c9a24a"
          transform="translate(198 34) rotate(14) scale(.85)" />
  </g>

  <g stroke="#2f2a27" stroke-width="3" stroke-linejoin="round">
    <g transform="translate(60 21) scale(.82)">
      <circle r="13" fill="#e9a9bd" />
      <path d="M0 -8 C6 -7 7 0 2 3 C-3 5 -6 0 -3 -3 C-1 -5 2 -4 2 -2" fill="none" />
    </g>
    <g transform="translate(150 30)">
      <circle r="13" fill="#e9a9bd" />
      <path d="M0 -8 C6 -7 7 0 2 3 C-3 5 -6 0 -3 -3 C-1 -5 2 -4 2 -2" fill="none" />
    </g>
    <g transform="translate(240 21) scale(.82)">
      <circle r="13" fill="#e9a9bd" />
      <path d="M0 -8 C6 -7 7 0 2 3 C-3 5 -6 0 -3 -3 C-1 -5 2 -4 2 -2" fill="none" />
    </g>
  </g>
</svg>

<style>
  .roses {
    position: absolute;
    top: 6px;
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
    z-index: 0;
  }
</style>
