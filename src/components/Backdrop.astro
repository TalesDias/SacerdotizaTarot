---
/**
 * The eight blurred colour blobs behind the page.
 *
 * In the canvas these were re-computed on every scroll event, but the parallax
 * multiplier was 0 — the transform always resolved to translate3d(0,0,0). They
 * are static, so this is plain CSS with no listener.
 */
const PALETTE = ['#f4a3b4', '#93d2d4', '#cfc0ee', '#e3d9a8'];
const SHAPES = [
  '48% 52% 44% 56% / 52% 44% 56% 48%',
  '56% 44% 52% 48% / 44% 56% 48% 52%',
  '42% 58% 60% 40% / 55% 45% 55% 45%',
  '50%',
];

const SPOTS = [
  { top: '1%', left: '-9%', size: '44vw', c: 3, o: 0.95, b: 3, d: 26 },
  { top: '11%', right: '-13%', size: '34vw', c: 1, o: 0.8, b: 4, d: 32 },
  { top: '26%', left: '-7%', size: '26vw', c: 2, o: 0.75, b: 5, d: 29 },
  { top: '38%', right: '-5%', size: '22vw', c: 3, o: 0.8, b: 4, d: 35 },
  { top: '52%', left: '4%', size: '17vw', c: 1, o: 0.7, b: 6, d: 24 },
  { top: '64%', right: '-9%', size: '30vw', c: 2, o: 0.8, b: 5, d: 31 },
  { top: '79%', left: '-11%', size: '28vw', c: 3, o: 0.75, b: 5, d: 28 },
  { top: '91%', right: '3%', size: '15vw', c: 1, o: 0.7, b: 4, d: 33 },
];

const wash = (hex: string) => `color-mix(in oklab, ${hex} 62%, #fff8f2)`;

const blobs = SPOTS.map((s, i) => ({
  outer: [
    'position:absolute',
    `top:${s.top}`,
    s.left ? `left:${s.left}` : '',
    s.right ? `right:${s.right}` : '',
    `width:${s.size}`,
    `height:${s.size}`,
    `border-radius:${SHAPES[i % SHAPES.length]}`,
    `background:${wash(PALETTE[s.c % PALETTE.length])}`,
    `opacity:${s.o}`,
    `filter:blur(${s.b}px)`,
  ]
    .filter(Boolean)
    .join(';'),
  inner: `animation:sfloat${i % 2 ? 'B' : 'A'} ${s.d}s ease-in-out ${i * -3}s infinite`,
}));
---

<div class="backdrop" aria-hidden="true">
  {blobs.map((b) => <div style={b.outer}><div class="blob-inner" style={b.inner} /></div>)}
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .blob-inner {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: inherit;
  }
</style>
