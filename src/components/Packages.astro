---
import { PACKAGES } from '../data/content';
import { waLink } from '../data/site';
import PackageCard from './PackageCard.astro';
---

<section id="pacotes" class="section">
  <div class="section-head">
    <h2>Pacotes</h2>
    <span class="rule" style="background:var(--accent-4)"></span>
    <p class="lede">
      Tiragens e perguntas avulsas reunidas em um só atendimento, por um valor menor que o dos itens
      separados.
    </p>
  </div>

  <div class="row" data-pkg-row>
    {PACKAGES.map((pkg) => <div class="slot"><PackageCard pkg={pkg} /></div>)}
  </div>

  <div class="dots" data-pkg-dots>
    {
      PACKAGES.map((pkg, i) => (
        <button type="button" class="dot" aria-label={`Ver ${pkg.name}`} aria-current={i === 0 ? 'true' : 'false'} />
      ))
    }
  </div>

  <div class="cta-row">
    <a
      class="btn btn-solid"
      href={waLink('Olá, gostaria de fechar um pacote')}
      target="_blank"
      rel="noopener">Fechar um pacote</a
    >
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 36px;
  }

  .section-head h2 {
    font-size: clamp(30px, 4.4vw, 50px);
  }

  .lede {
    max-width: 560px;
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--body);
  }

  .row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }

  .slot {
    display: flex;
    flex: 1 1 268px;
    min-width: 268px;
    max-width: 360px;
  }

  /*
   * Phones: one card at a time, swiped. Five stacked cards made the section a
   * long scroll on its own, and the arc below needs width the phone has not
   * got. 759px is the same line the reading grid drops to one column at.
   */
  @media (max-width: 759px) {
    .row {
      flex-wrap: nowrap;
      justify-content: flex-start;
      /* Equal-height cards: without this each snaps to its own content and the
         strip's baseline jumps card to card as you swipe. */
      align-items: stretch;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 24px;
      /* Keeps a swipe past the last card from triggering back-navigation. */
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      /* overflow-x clips the y axis too, so the card shadow needs room inside
         the scrollport; the matching negative margins hand that room back to
         the layout, leaving the section's spacing exactly as it was. */
      margin: -10px -24px -26px;
      padding: 10px 0 26px;
    }

    .row::-webkit-scrollbar {
      display: none;
    }

    .slot {
      /* Never a full card width, so the next one always peeks and the strip
         reads as swipeable without a hint under it. */
      flex: 0 0 78%;
      min-width: 0;
      max-width: none;
      scroll-snap-align: start;
    }

    /* Safari drops a horizontal scroller's trailing padding, so the end gutter
       is a margin on the last card instead. */
    .slot:first-child {
      margin-left: 24px;
    }

    .slot:last-child {
      margin-right: 24px;
    }

    .dots[data-ready] {
      display: flex;
    }

    .cta-row {
      margin-top: 22px;
    }
  }

  /*
   * Above 1180px the five cards fan into an arc and the row breaks out of the
   * 1180px container. The canvas drove this from a window resize listener.
   */
  @media (min-width: 1180px) {
    .row {
      flex-wrap: nowrap;
      gap: 14px;
      width: min(1420px, calc(100vw - 48px));
      margin-left: 50%;
      transform: translateX(-50%);
    }

    .slot {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      transition: margin-top 0.3s ease;
    }

    .slot:nth-child(1),
    .slot:nth-child(5) {
      margin-top: 240px;
    }

    .slot:nth-child(2),
    .slot:nth-child(4) {
      margin-top: 120px;
    }
  }

  /* Hidden until the script wires them up, so a visitor without JS is never
     shown a row of dead controls under a strip that still swipes fine. */
  .dots {
    display: none;
    justify-content: center;
    gap: 2px;
    margin-top: 14px;
  }

  .dot {
    display: grid;
    place-items: center;
    /* 8px of paint, but a 24px target — the WCAG 2.5.8 minimum. */
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    /* Hollow vs filled carries the state, both drawn in clay. A pale fill would
       sit at 1.4:1 on the cream and effectively disappear — WCAG 1.4.11 wants
       3:1 for a control you have to see to use. */
    box-shadow: inset 0 0 0 1.5px var(--clay);
    transition:
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .dot[aria-current='true']::before {
    background: var(--clay);
    transform: scale(1.3);
  }

  .dot:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 1px;
  }

  .cta-row {
    margin-top: 30px;
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>('[data-pkg-row]');
  const dots = document.querySelector<HTMLElement>('[data-pkg-dots]');

  if (row && dots) {
    const slots = [...row.children];
    const buttons = [...dots.children] as HTMLButtonElement[];

    dots.dataset.ready = '';

    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        slots[i].scrollIntoView({
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'nearest',
          inline: 'start',
        });
      });
    });

    // A card is "current" once it fills 80% of the strip. Cards are 78% of the
    // scrollport, so two can never clear that bar at once and exactly one dot
    // is ever marked, mid-swipe included.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const current = slots.indexOf(entry.target);
          buttons.forEach((button, i) => button.setAttribute('aria-current', String(i === current)));
        }
      },
      { root: row, threshold: 0.8 },
    );

    slots.forEach((slot) => observer.observe(slot));
  }
</script>
