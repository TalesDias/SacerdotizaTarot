---
import { PACKAGES } from '../data/content';
import { waLink } from '../data/site';
import PackageCard from './PackageCard.astro';

// The arc peaks at its middle slot, so the featured package has to be placed
// there rather than wherever it sits in the list. Everything else keeps its
// relative order and fans out around it. DOM order is left alone — it is what
// the phone carousel, the crawler and a screen reader all read.
const peak = Math.floor(PACKAGES.length / 2);
const featured = PACKAGES.findIndex((pkg) => pkg.featured);
const centre = featured === -1 ? peak : featured;

const arc: number[] = [];
arc[centre] = peak;
PACKAGES.map((_, i) => i)
  .filter((i) => i !== centre)
  .forEach((i, slot) => {
    arc[i] = slot < peak ? slot : slot + 1;
  });
---

<section id="pacotes" class="section">
  <div class="section-head">
    <h2>Pacotes</h2>
    <span class="rule" style="background:var(--accent-4)"></span>
    <p class="lede">
      Tiragens e perguntas avulsas reunidas em um só atendimento, por um valor menor que o dos itens
      separados.
    </p>
  </div>

  <div class="row" data-pkg-row>
    {
      PACKAGES.map((pkg, i) => (
        <div class="slot" data-arc={arc[i]} style={`--arc:${arc[i]}`}>
          <PackageCard pkg={pkg} />
        </div>
      ))
    }
  </div>

  <div class="dots" data-pkg-dots>
    {
      PACKAGES.map((pkg, i) => (
        <button type="button" class="dot" aria-label={`Ver ${pkg.name}`} aria-current={i === 0 ? 'true' : 'false'} />
      ))
    }
  </div>

  <div class="cta-row">
    <a
      class="btn btn-solid"
      href={waLink('Olá, gostaria de fechar um pacote')}
      target="_blank"
      rel="noopener">Fechar um pacote</a
    >
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 36px;
  }

  .section-head h2 {
    font-size: clamp(30px, 4.4vw, 50px);
  }

  .lede {
    max-width: 560px;
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--body);
  }

  .row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }

  .slot {
    display: flex;
    flex: 1 1 268px;
    min-width: 268px;
    max-width: 360px;
  }

  /* Wrap-around spares, added by the script. They exist only for the phone
     strip; the grid and the arc show the five real cards. */
  .slot.clone {
    display: none;
  }

  /*
   * Phones: one card at a time, swiped. Five stacked cards made the section a
   * long scroll on its own, and the arc below needs width the phone has not
   * got. 759px is the same line the reading grid drops to one column at.
   */
  @media (max-width: 759px) {
    .row {
      flex-wrap: nowrap;
      justify-content: flex-start;
      /* Equal-height cards: without this each snaps to its own content and the
         strip's baseline jumps card to card as you swipe. */
      align-items: stretch;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* Keeps a swipe past the last card from triggering back-navigation. */
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      /* overflow-x clips the y axis too, so the card shadow needs room inside
         the scrollport; the matching negative margins hand that room back to
         the layout, leaving the section's spacing exactly as it was. */
      margin: -10px -24px -26px;
      padding: 10px 0 26px;
    }

    .row::-webkit-scrollbar {
      display: none;
    }

    .slot {
      /* Never a full card width, so a slice of the card either side always
         shows and the strip reads as swipeable without a hint under it. */
      flex: 0 0 78%;
      min-width: 0;
      max-width: none;
      /* Centred, so the two slices are the same width. Aligning to the start
         left a 10px sliver behind and a 62px one ahead, which read as the next
         card being nearer than the last. */
      scroll-snap-align: center;
      /* One card per flick — so a fast swipe can never outrun the spares at
         the ends of the strip. */
      scroll-snap-stop: always;
    }

    .slot.clone {
      display: flex;
    }

    /* Half the leftover width, so the first and last cards can still reach the
       middle. Only reachable with the script off; the loop never gets here. */
    .slot:first-child {
      margin-left: 11%;
    }

    .slot:last-child {
      margin-right: 11%;
    }

    .dots[data-ready] {
      display: flex;
    }

    .cta-row {
      margin-top: 22px;
    }
  }

  /*
   * Above 1180px the five cards fan into an arc and the row breaks out of the
   * 1180px container. The canvas drove this from a window resize listener.
   */
  @media (min-width: 1180px) {
    .row {
      flex-wrap: nowrap;
      gap: 14px;
      width: min(1420px, calc(100vw - 48px));
      margin-left: 50%;
      transform: translateX(-50%);
    }

    .slot {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      transition: margin-top 0.3s ease;
    }

    /* Laid out by arc slot, not by document position: the featured package
       takes the peak, and the carousel clones would shift any nth-child. */
    .slot {
      order: var(--arc);
    }

    .slot[data-arc='0'],
    .slot[data-arc='4'] {
      margin-top: 240px;
    }

    .slot[data-arc='1'],
    .slot[data-arc='3'] {
      margin-top: 120px;
    }
  }

  /* Hidden until the script wires them up, so a visitor without JS is never
     shown a row of dead controls under a strip that still swipes fine. */
  .dots {
    display: none;
    justify-content: center;
    gap: 2px;
    margin-top: 14px;
  }

  .dot {
    display: grid;
    place-items: center;
    /* 8px of paint, but a 24px target — the WCAG 2.5.8 minimum. */
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    /* Hollow vs filled carries the state, both drawn in clay. A pale fill would
       sit at 1.4:1 on the cream and effectively disappear — WCAG 1.4.11 wants
       3:1 for a control you have to see to use. */
    box-shadow: inset 0 0 0 1.5px var(--clay);
    transition:
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .dot[aria-current='true']::before {
    background: var(--clay);
    transform: scale(1.3);
  }

  .dot:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 1px;
  }

  .cta-row {
    margin-top: 30px;
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>('[data-pkg-row]');
  const dots = document.querySelector<HTMLElement>('[data-pkg-dots]');

  if (row && dots) {
    const real = [...row.children] as HTMLElement[];
    const buttons = [...dots.children] as HTMLButtonElement[];
    const count = real.length;
    // Spare copies at both ends, so the strip always has a card waiting in the
    // direction you are swiping and can be rewound a whole set at a time.
    const lead = 2;

    const spare = (card: HTMLElement) => {
      const copy = card.cloneNode(true) as HTMLElement;
      copy.classList.add('clone');
      // The original is already in the accessibility tree and in the HTML the
      // crawler is served; these are scenery.
      copy.setAttribute('aria-hidden', 'true');
      return copy;
    };

    row.prepend(...real.slice(count - lead).map(spare));
    row.append(...real.slice(0, lead).map(spare));

    const items = [...row.children] as HTMLElement[];
    const mid = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2;
    const eye = () => row.scrollLeft + row.clientWidth / 2;
    const closest = (candidates: number[]) =>
      candidates.reduce((a, b) => (Math.abs(mid(items[b]) - eye()) < Math.abs(mid(items[a]) - eye()) ? b : a));

    const nearest = () => closest(items.map((_, i) => i));

    let current = 0;
    const paint = () => {
      current = (((nearest() - lead) % count) + count) % count;
      buttons.forEach((b, j) => b.setAttribute('aria-current', String(j === current)));
    };

    const centre = (i: number) => mid(items[i]) - row.clientWidth / 2;

    // Once the strip settles on a spare, slide to the real card showing the
    // same thing. Both positions are pixel-identical, so nothing is seen to
    // move — that jump is what makes the loop endless.
    const rewind = () => {
      const i = nearest();
      if (i < lead) row.scrollLeft += mid(items[i + count]) - mid(items[i]);
      else if (i >= lead + count) row.scrollLeft -= mid(items[i]) - mid(items[i - count]);
    };

    let idle = 0;
    let dragging = false;
    // Never rewind under a finger: moving the scroller mid-drag makes the
    // browser recompute the gesture from the new offset and the card snaps back.
    const settle = () => {
      clearTimeout(idle);
      idle = window.setTimeout(() => {
        if (!dragging) rewind();
      }, 140);
    };

    row.addEventListener('scroll', () => { paint(); settle(); }, { passive: true });
    row.addEventListener('touchstart', () => { dragging = true; }, { passive: true });
    row.addEventListener('touchend', () => { dragging = false; settle(); }, { passive: true });

    buttons.forEach((button, n) => {
      button.addEventListener('click', () => {
        // Whichever copy of that card is nearest, so the dots wrap the short
        // way round instead of rewinding the whole strip.
        const to = closest([lead + n - count, lead + n, lead + n + count].filter((i) => i >= 0 && i < items.length));
        row.scrollTo({
          left: centre(to),
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      });
    });

    // A rotation changes every card's width, so the strip would re-snap to
    // whichever card happened to fall nearest the middle. Put it back on the
    // one that was being read.
    let resized = 0;
    addEventListener('resize', () => {
      clearTimeout(resized);
      resized = window.setTimeout(() => {
        row.scrollLeft = centre(lead + current);
      }, 150);
    });

    row.scrollLeft = centre(lead);
    paint();
    dots.dataset.ready = '';
  }
</script>
