---
import { PACKAGES } from '../data/content';
import { waLink } from '../data/site';
import PackageCard from './PackageCard.astro';
---

<section id="pacotes" class="section">
  <div class="section-head">
    <h2>Pacotes</h2>
    <span class="rule" style="background:var(--accent-4)"></span>
    <p class="lede">
      Tiragens e perguntas avulsas reunidas em um só atendimento, por um valor menor que o dos itens
      separados.
    </p>
  </div>

  <div class="row">
    {PACKAGES.map((pkg) => <div class="slot"><PackageCard pkg={pkg} /></div>)}
  </div>

  <div class="cta-row">
    <a
      class="btn btn-solid"
      href={waLink('Olá, gostaria de fechar um pacote')}
      target="_blank"
      rel="noopener">Fechar um pacote</a
    >
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 36px;
  }

  .section-head h2 {
    font-size: clamp(30px, 4.4vw, 50px);
  }

  .lede {
    max-width: 560px;
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--body);
  }

  .row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }

  .slot {
    display: flex;
    flex: 1 1 268px;
    min-width: 268px;
    max-width: 360px;
  }

  /*
   * Above 1180px the five cards fan into an arc and the row breaks out of the
   * 1180px container. The canvas drove this from a window resize listener.
   */
  @media (min-width: 1180px) {
    .row {
      flex-wrap: nowrap;
      gap: 14px;
      width: min(1420px, calc(100vw - 48px));
      margin-left: 50%;
      transform: translateX(-50%);
    }

    .slot {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      transition: margin-top 0.3s ease;
    }

    .slot:nth-child(1),
    .slot:nth-child(5) {
      margin-top: 240px;
    }

    .slot:nth-child(2),
    .slot:nth-child(4) {
      margin-top: 120px;
    }
  }

  .cta-row {
    margin-top: 30px;
  }
</style>
