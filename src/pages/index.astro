---
import { getImage, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import Hero from '../components/Hero.astro';
import Spreads from '../components/Spreads.astro';
import Divider from '../components/Divider.astro';
import Questions from '../components/Questions.astro';
import Packages from '../components/Packages.astro';
import Faq from '../components/Faq.astro';
import PromoDialog from '../components/PromoDialog.astro';
import portrait from '../assets/yara.webp';
import shoyu from '../assets/cats/shoyu.png';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import {
  SITE_NAME,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  DEVELOPER,
  DEVELOPER_URL,
} from '../data/site';

// Resolved build path, so the structured data points at a real image.
const portraitImg = await getImage({ src: portrait, format: 'webp', width: 520 });
---

<Base portraitUrl={portraitImg.src}>
  <div class="page">
    <Backdrop />
    <Hero />

    <main>
      <Spreads />
      <Divider perch="amarula" />
      <Questions />
      <Divider />
      <Packages />
      <Divider perch="pacoca" />
      <Faq />
    </main>

    <div class="companion">
      <Picture
        src={shoyu}
        alt=""
        widths={[240, 480, 661]}
        sizes="240px"
        formats={['avif']}
        fallbackFormat="webp"
        loading="lazy"
      />
    </div>

    <footer>
      <p class="brand">
        {SITE_NAME} · <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
      </p>
      <p class="credit">
        Desenvolvido por <a href={DEVELOPER_URL} target="_blank" rel="noopener">
          <GitHubIcon />{DEVELOPER}
        </a>
      </p>
    </footer>
  </div>

  <PromoDialog />
</Base>

<style>
  .page {
    position: relative;
    max-width: 100%;
    overflow-x: hidden;
    background: var(--base);
  }

  main {
    position: relative;
    z-index: 1;
  }

  /* Shoyu sees the page out, sitting between the last word of the FAQ and the
     brand line. Decorative, so he carries no alt text and no landmark. */
  .companion {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    /* The FAQ's 56px of bottom padding and the footer's 16px do not centre him
       between the two lines on their own; this splits the difference without
       changing how tall the block is. */
    margin-top: -17px;
    /* Padding, not margin: a bottom margin here would collapse into the
       footer's own and the space would not appear. */
    padding-bottom: 16px;
  }

  .companion :global(img) {
    width: auto;
    height: 175px;
  }

  footer {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    /*
     * Wide enough that the chip is plainly its own thing and not a third line
     * under a brand that wraps to two on a phone. The bottom padding matches
     * the left inset instead of the section rhythm: the chip sits in the
     * page's corner, so the two edges it hangs off are the same distance away.
     */
    gap: 138px;
    margin-top: 16px;
    padding: 0 24px 24px;
    text-align: center;
    color: var(--clay);
  }

  .brand {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /*
   * A maker's mark rather than a third brand line: pulled out of the centred
   * column into the page's bottom-left corner and set on its own clay chip, so
   * it reads as a signature beside the footer instead of competing with it.
   */
  .credit {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--clay);
    /* Cream on clay measures 4.79:1 — AA for text this small. */
    color: var(--base);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    /* The username is camel case; uppercasing it would lose that. */
    text-transform: none;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition:
      background 220ms var(--ease),
      transform 220ms var(--ease);
  }

  .credit:hover {
    background: var(--ink);
    transform: translateY(-1px);
  }

  /*
   * Only the name is the link, so it carries the weight and the underline; the
   * padding buys it a 24px-tall hit target and the matching negative margin
   * keeps that off the chip's own size.
   */
  .credit a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 6px;
    margin: -5px -6px;
    color: inherit;
    font-weight: 700;
    /* Keeps the mark glued to the name if the line ever wraps. */
    white-space: nowrap;
  }

  .credit a:hover,
  .credit a:focus-visible {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * A corner badge needs a corner to sit in. On a phone the gutters are too
   * narrow for the offset to read as deliberate, so it centres under the
   * brand instead.
   */
  @media (max-width: 759px) {
    .credit {
      justify-self: center;
    }
  }

</style>
